Bootstrap: docker
From: pytorch/pytorch:2.2.1-cuda12.1-cudnn8-runtime

# React-OT generative-TS sidecar (DeepPrinciple).
#
# React-OT's stack (torch 2.2.1 + torch_geometric/scatter/sparse/cluster +
# pytorch-lightning 2.4) conflicts with the main qcb container, so it runs here,
# invoked like the UMA sidecar:
#   apptainer exec --nv --bind /home --bind /net reactot-<date>.sif \
#     python -m quantum_engine.cli ts-entry --proposer react-ot ...
#
# Build (user; container builds are not done from the agent):
#   apptainer build --fakeroot reactot-$(date +%Y%m%d).sif deps/reactot_sidecar.def
#
# Weights: download the React-OT checkpoint from https://zenodo.org/records/13131875
# into  /net/databases/huggingface/generative_ts_models/react-ot/  (= site.REACTOT_CKPT).
#
# Pins are taken from the repo's env.yaml (python 3.10.14, torch 2.2.1,
# pytorch-lightning 2.4.0, numpy 1.26.4). e3nn is NOT required (it is commented out
# in env.yaml and never imported under reactot/). The geometric companions
# (torch-scatter/sparse/cluster) MUST match the torch+CUDA build — install them
# from the matched wheel index. The adapter (quantum_engine/qm/reactot.py) drives
# reactot.run_model.parse_rxn_xyzs + make_pred (the internals of pred_ts), so the
# `reactot` package must import cleanly here; validate one forward pass end-to-end
# in this container (it cannot be exercised in the main container).

%post
    set -e
    PIP="pip install --no-cache-dir"
    # torch 2.2.1 ships in the base image; pin the rest of the stack to env.yaml.
    $PIP numpy==1.26.4 pytorch-lightning==2.4.0
    $PIP ase==3.23.0 pymatgen networkx torchdiffeq lmdb rich timm
    # torch_geometric companions matched to torch 2.2.1 + cu121:
    $PIP torch_geometric
    $PIP torch-scatter torch-sparse torch-cluster \
        -f https://data.pyg.org/whl/torch-2.2.1+cu121.html
    # React-OT itself (import package is `reactot`; editable install discovers it).
    cd /opt && git clone https://github.com/deepprinciple/react-ot.git
    cd /opt/react-ot && $PIP -e .

%environment
    export PYTHONNOUSERSITE=1

%test
    python -c "from reactot.run_model import parse_rxn_xyzs, make_pred; print('reactot inference API OK')"
    python -c "from reactot.trainer.pl_trainer import SBModule; print('SBModule OK')"
    python -c "import torch, torch_geometric, torch_scatter, ase; print('deps OK', torch.__version__)"
