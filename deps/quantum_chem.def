Bootstrap: localimage
From: /net/software/containers/universal.sif

# QCB enzyme TS-search pipeline container — single image holding every
# chemistry / MLFF / path-search dep we use across enzyme_ts_design and
# mcsa_theozyme.
#
# Strategy: build on the lab's universal.sif (Python 3.11 + torch 2.11 +
# mace 0.3.15 + rdkit + biotite) and pip-add everything else — autodE,
# RXNMapper, SCINE Chemoton/ReaDuct/Sparrow, orb-models, AIMNet (no extras),
# pysisyphus, sella, openmm-ml + openmm-plumed, CGRtools.
#
# Pin numpy to 1.26.4 — that's the only version SCINE Chemoton 4.1.0
# tolerates AND that AIMNet (sans [sella,pysis] extras) accepts. Without
# this pin, sella/pysisyphus pulled in numpy 2.4 and broke SCINE.
#
# Build:
#   apptainer build --fakeroot \
#       /net/software/containers/users/woodbuse/quantum_chem/quantum_chem-$(date +%Y%m%d).sif \
#       deps/quantum_chem.def
#
# Run (example — explicit binds to /net for shared databases):
#   apptainer exec --nv \
#       --bind /home:/home --bind /net:/net --bind /mnt:/mnt \
#       /net/software/containers/users/woodbuse/quantum_chem/quantum_chem.sif \
#       python -m enz_qc_pipelines.mcsa_theozyme.cli --mcsa-id 159 ...

%labels
    Author woodbuse@uw.edu
    Project qcb (quantum_cowboy_biochemistry)
    Repo https://github.com/SethWoodbury/quantum_cowboy_biochemistry
    Base universal.sif
    NumpyPin 1.26.4

%post
    # apptainer's %post runs under /bin/sh (dash), which lacks pipefail.
    # set -eux is enough — pip already errors out on its own pipe failures.
    set -eux

    # Use a constraints file so EVERY install (incl. transitive deps)
    # honours our hard pins on numpy / torch / e3nn / pydantic. Without
    # this, fairchem-core (and friends) silently upgrade torch / numpy
    # under the feet of MACE / SCINE Chemoton and break the runtime.
    # Constraints file: hard pins on numpy + torch + e3nn so transitive
    # deps (orb-models, fairchem, etc.) can't downgrade torch / upgrade
    # numpy under us. Scipy is left to float — orb-models needs >=1.13
    # and 1.13+ is binary-compatible with numpy 1.26.
    cat > /tmp/qc_constraints.txt <<'CONSTRAINTS'
numpy==1.26.4
torch==2.11.0+cu130
e3nn==0.4.4
mace-torch==0.3.15
pydantic<2.0
CONSTRAINTS

    # --constraint is a `pip install` flag, not a global pip flag, so
    # we keep it separate from $PIP and append it on every install line.
    PIP="/usr/local/conda/bin/pip --no-cache-dir"
    C="--constraint /tmp/qc_constraints.txt"

    # Refresh pip itself (no constraint — pip's not a runtime dep).
    $PIP install --upgrade pip

    # ── 1. Re-pin numpy explicitly so the constraint takes effect first ──
    $PIP install $C "numpy==1.26.4"

    # ── 2. Chemistry workflow tools ──────────────────────────────────────
    $PIP install $C \
        "rdkit>=2024.03" \
        "epam.indigo>=1.27" \
        "rxnmapper>=0.4" \
        "CGRtools==4.1.27" \
        "biotite" \
        "ase>=3.23" \
        "matplotlib>=3.7"

    # autodE — only on GitHub, not PyPI. Pin to a tested release.
    $PIP install $C "git+https://github.com/duartegroup/autodE.git@v1.4.5"

    # ── 3. Path-search engines (vendor-installed too, but having pip-
    # versioned copies inside the container makes the runtime hermetic) ──
    $PIP install $C \
        "pysisyphus>=0.7" \
        "sella>=2.3"

    # ── 4. SCINE Chemoton + ReaDuct + Sparrow (Linux-64 wheels only) ────
    $PIP install $C \
        "scine-chemoton==4.1.0" \
        "scine-readuct==6.1.0" \
        "scine-sparrow==5.1.0" \
        || echo "WARN: scine install hit a snag; container still ships without it"

    # ── 5. MLFF model loaders ───────────────────────────────────────────
    # mace-torch is already in the base universal.sif (0.3.15). Just add
    # the openmm-ml integration so we can swap MACE / ANI in OpenMM.
    $PIP install $C \
        "openmm-ml" \
        "openmm-plumed" \
        || echo "WARN: openmm-ml/plumed install failed; container still functional"

    # OrbMol via the Orbital Materials package
    $PIP install $C "orb-models" || echo "WARN: orb-models install failed"

    # AIMNet without [sella,pysis] extras (those force numpy 2.x which
    # would break SCINE). Pysisyphus + sella are installed separately above.
    $PIP install $C "aimnet" || echo "WARN: aimnet install failed"

    # NOTE: fairchem-core was tried but it transitively pulls torch 2.8 +
    # numpy 2.x + new pydantic which breaks the rest of the stack even
    # under --constraint. Until UMA-S-1.2 / UMA-M-1.1 are downloadable
    # (gated), we skip fairchem in the container. The legacy uma-sm
    # checkpoint loads via the `fairchem` lite path or a separate env.

    # ── 6. Final sanity check ───────────────────────────────────────────
    # Run each import in a fresh subprocess + tolerate non-zero exit
    # (segfaults included). Otherwise a single bad wheel aborts the
    # whole build at the very end. Failures here are diagnostic only;
    # the container is shipped regardless.
    set +e
    /usr/local/conda/bin/python -c "import numpy; print('numpy:', numpy.__version__)" 2>&1 | tail -1
    for mod in torch mace rdkit ase biotite rxnmapper CGRtools autode \
               pysisyphus sella scine_chemoton scine_readuct \
               orb_models aimnet ; do
        /usr/local/conda/bin/python -c "import importlib; m = importlib.import_module('$mod'); v = getattr(m, '__version__', '?'); print('  $mod:', v)" 2>&1 | tail -1 || echo "  $mod: FAIL (segfault or import error)"
    done
    set -e

    # Make /tmp writable inside the container (some packages assume it).
    mkdir -p /tmp /scratch
    chmod 1777 /tmp /scratch || true

%environment
    export QCB_CONTAINER=quantum_chem
    # Point HuggingFace cache at the lab-shared registry so MACE / OrbMol /
    # AIMNet checkpoints don't get re-downloaded per-user.
    export HF_HOME=/net/databases/huggingface
    export TRANSFORMERS_CACHE=$HF_HOME/hub
    # No mace-polar graph_electrostatics yet (gbg222's venv only); set this
    # when we fold that in later.

%runscript
    exec /usr/local/conda/bin/python "$@"

%help
    Apptainer container for the QCB enzyme TS-search pipeline.

    Usage:
        apptainer exec --nv --bind /net:/net --bind /home:/home \
            quantum_chem.sif python -m enz_qc_pipelines.mcsa_theozyme.cli ...

    Or as a Python interpreter:
        apptainer exec --nv --bind /net:/net quantum_chem.sif python script.py

    The QCB git checkout lives under your $HOME and is mounted into the
    container. Editable install:
        apptainer exec quantum_chem.sif pip install -e /home/woodbuse/codebase_projects/quantum_cowboy_biochemistry

    See deps/quantum_chem.def for the build recipe and
    /net/software/containers/users/woodbuse/quantum_chem/ for the .sif.
