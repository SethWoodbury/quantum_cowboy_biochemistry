Bootstrap: docker
From: condaforge/miniforge3:latest

# AEFM generative-TS *refiner* sidecar (Darouich et al., JCIM 2025).
#
# AEFM's stack (schnetpack>2 + torch_geometric + torchdiffeq + e3nn, python 3.12)
# conflicts with the main qcb container, so it runs here, invoked like the UMA /
# React-OT sidecars:
#   apptainer exec --nv --bind /home --bind /net aefm-<date>.sif \
#     python -m quantum_engine.cli ts-entry --refiner aefm ...
#
# Build (validated 2026-06-05 — refined a 14-atom CHON guess end-to-end via the adapter):
#   export APPTAINER_CACHEDIR=/tmp/apptainer_cache APPTAINER_TMPDIR=/tmp/apptainer_tmp
#   apptainer build --fakeroot --ignore-fakeroot-command \
#     containers/aefm-$(date +%Y%m%d).sif deps/aefm_sidecar.def
#   (--ignore-fakeroot-command: host isn't in /etc/subuid → root-mapped namespace.)
#
# Weights: download an AEFM checkpoint from https://zenodo.org/records/16414436
# into  /net/databases/huggingface/generative_ts_models/aefm/  (= site.AEFM_MODEL):
#   aefm_xtb_ci_neb.pt  — refine a generic low-fidelity guess (NEB/GSM peak)  [default]
#   aefm_reactot.pt     — refine React-OT output (the React-OT → AEFM chain)
#
# The adapter (quantum_engine/qm/aefm.py) drives AEFM's own `aefm_sample` CLI, so
# this container only needs AEFM importable + that console script on PATH. The
# CRITICAL footgun is the torch ↔ torch-scatter ↔ torch_geometric ↔ CUDA quad —
# install the geometric companions from the wheel index that matches the torch +
# CUDA you pick below, then validate one refine end-to-end here (it cannot be
# exercised in the main container).

%post
    set -e
    . /opt/conda/etc/profile.d/conda.sh
    # AEFM is developed/tested on python 3.12 (README).
    conda create -y -n aefm python=3.12
    conda activate aefm
    PIP="pip install --no-cache-dir"
    # git is needed to clone AEFM; install it into the env (apt needs fakeroot).
    conda install -y -c conda-forge git

    # 1) torch FIRST, PINNED. schnetpack 2.2.0 needs torch>=2.5.0; torch-scatter
    #    cu121 wheels exist up to torch 2.5.1 — so 2.5.1 is the compatible apex.
    $PIP torch==2.5.1 --index-url https://download.pytorch.org/whl/cu121
    # 2) geometric companions MUST match the torch+CUDA above (URL pinned to 2.5.1).
    $PIP torch_geometric
    $PIP torch-scatter -f https://data.pyg.org/whl/torch-2.5.1+cu121.html
    # 3) AEFM's inference deps. NOTE: aefm.utils.analysis (pulled in transitively by
    #    the sampler import chain) imports py3Dmol + pyscf + geometric AT MODULE LOAD,
    #    so those three are REQUIRED even for pure refinement — only tblite (used just
    #    in training configs) is safely omitted. The trailing torch==2.5.1 PIN stops
    #    schnetpack (needs >=2.5.0) from upgrading torch past the matching
    #    torch-scatter wheel. matplotlib+biotite are quantum_engine's own runtime deps
    #    (so `python -m quantum_engine.cli` runs inside this sidecar); numpy/scipy/ase
    #    come transitively.
    $PIP "schnetpack>2.0.0" "torchdiffeq>0.2" e3nn "pot>0.9" pymatgen \
         hydra-core omegaconf "ase>=3.23" tqdm rich matplotlib biotite \
         py3Dmol pyscf geometric "torch==2.5.1"
    # 4) AEFM itself, with --no-deps so pip doesn't drag the omitted training deps in.
    cd /opt && git clone https://github.com/samirdarouich/AEFM.git
    cd /opt/AEFM && $PIP -e . --no-deps

%environment
    export PYTHONNOUSERSITE=1
    # make the `aefm` conda env the default python for `apptainer exec`
    export PATH=/opt/conda/envs/aefm/bin:$PATH

%runscript
    exec /opt/conda/envs/aefm/bin/python "$@"

%test
    . /opt/conda/etc/profile.d/conda.sh && conda activate aefm
    python -c "import aefm; from aefm.sampler import AEFMSampler; print('aefm OK')"
    python -c "import shutil; assert shutil.which('aefm_sample'), 'aefm_sample not on PATH'; print('aefm_sample OK')"
    python -c "import torch, torch_geometric, schnetpack; print('deps OK', torch.__version__)"
