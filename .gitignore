# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Environments
.venv/
deps/.local_pkgs/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Outputs (generated by runs, don't version)
outputs/
runs/
logs/
cmds/
submit/
slurm-*.out
slurm-*.err

# Per-id caches (M-CSA / ChEBI fetches; recreated on demand)
data/mcsa_cache/
data/chebi_cache/
data/benchmark_cache/

# Large files
*.traj
*.model
*.sif
*.pt

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
deps/pyGSM/

# Source-only copies installed into deps/.local_pkgs (do not commit large source trees)
deps/mace_polar_src/
deps/graph_longrange_src/

# Vendored-submodule build artefacts (xtb, plumed2, etc.) — submodule pin is
# tracked, build outputs shouldn't be.
deps/*/install/
deps/*/build/
deps/*/subprojects/.wraplock

# pymbar / mace-polar may install local files; skip
deps/.local_pkgs/__pycache__/
