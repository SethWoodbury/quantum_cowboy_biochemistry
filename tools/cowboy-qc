#!/usr/bin/env python
"""Backwards-compatible CLI shim for `cowboy-qc`. The `quantum_engine` package
is also exposed as a console script via pyproject.toml's [project.scripts]
entry, so after `pip install -e .` users get `cowboy-qc` on PATH automatically.
This shim is for ad-hoc invocation from a clone without install.
"""
import sys
from pathlib import Path

_repo_root = Path(__file__).resolve().parent.parent
if str(_repo_root) not in sys.path:
    sys.path.insert(0, str(_repo_root))

from quantum_engine.cli import main

if __name__ == "__main__":
    sys.exit(main())
